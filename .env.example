# Server
PORT=8080
# Public base URL of this server (used by Stripe redirects, etc.)
BASE_URL=http://localhost:5173

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgres://postgres@127.0.0.1:55432/rfspager_test?sslmode=disable

# Required random JWT secret: generate with openssl rand -hex 32
JWT_SECRET=

# Optional explicit bootstrap. Both or neither; password must be 12–72 bytes.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Push notifications
# ---------------------------------------------------------------------------

# Firebase Cloud Messaging (for Android push notifications)
FIREBASE_CREDENTIALS=

# Apple Push Notification Service (for iOS push notifications)
APN_KEY_ID=
APN_TEAM_ID=
APN_BUNDLE_ID=io.devlan.rfspager
APN_PRIVATE_KEY=
APN_PRODUCTION=true

# ---------------------------------------------------------------------------
# In-app purchases — Apple App Store
# ---------------------------------------------------------------------------
# Used for: server-side JWS-signed transaction validation and (optionally) the
# App Store Server API fallback when the app cannot supply a JWS.
# Create the key at App Store Connect → Users and Access → Integrations →
# In-App Purchase. Download the .p8 once; the file content goes in
# APPLE_PRIVATE_KEY (literal newlines or "\n" both work via godotenv).

APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=io.devlan.rfspager

# ---------------------------------------------------------------------------
# In-app purchases — Google Play
# ---------------------------------------------------------------------------
# Path to the service-account JSON used to call Play Developer API. The
# service account needs the "View financial data, orders, and cancellation
# survey responses" + "View and manage" permissions on the Play Console.

GOOGLE_PLAY_CREDENTIALS=
GOOGLE_PLAY_PACKAGE=io.devlan.rfspager

# Real-Time Developer Notifications (RTDN) webhook auth.
# When you configure the Pub/Sub push subscription:
#   - Set "Enable authentication" and pick a service account.
#   - The "Audience" field there becomes GOOGLE_PUBSUB_AUDIENCE — typically
#     the public URL of this webhook (e.g. https://pager.example.org/api/webhooks/google).
#   - GOOGLE_PUBSUB_SERVICE_EMAIL is required with an audience: the email of
#     the service account used for the push subscription.

GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_EMAIL=

# ---------------------------------------------------------------------------
# Stripe (web checkout fallback)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Products accepted for validation/restore/webhooks (space or comma separated).
# Include all legitimate historical products before migrating existing accounts.
IAP_PRODUCT_IDS=io.devlan.rfspager.monthly io.devlan.rfspager.yearly
APPLE_IAP_ENVIRONMENT=Production
GOOGLE_IAP_ENVIRONMENT=Production

# Facebook login is disabled unless both server values are provided.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Password recovery (disabled until configured).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_MODE=starttls
# SMTP_MODE=tls uses implicit TLS (usually port 465). Plain is loopback-only.

# Only these reverse proxies may supply X-Forwarded-For to rate limiting.
# Leave empty for direct connections; list the actual proxy networks, not all IPs.
TRUSTED_PROXY_CIDRS=

# ---------------------------------------------------------------------------
# P25 radio: call recordings and transcription
# ---------------------------------------------------------------------------
# Recordings go to this directory unless the S3 settings below are set.
RADIO_AUDIO_DIR=./data/radio-audio
# S3-compatible bucket, e.g. Cloudflare R2
# (https://<account-id>.r2.cloudflarestorage.com, region auto). All four or
# none. The bucket should be private: audio is served through the API.
RADIO_AUDIO_S3_ENDPOINT=
RADIO_AUDIO_S3_BUCKET=
RADIO_AUDIO_S3_ACCESS_KEY_ID=
RADIO_AUDIO_S3_SECRET_ACCESS_KEY=
RADIO_AUDIO_S3_REGION=auto

# OpenAI-compatible transcription endpoint (.../v1/audio/transcriptions).
# Transcription is off unless ASR_URL and ASR_API_KEY are both set.
ASR_URL=
ASR_MODEL=Qwen/Qwen3-ASR-1.7B
ASR_API_KEY=
# Optional language hint (ISO-639-1), e.g. en.
ASR_LANGUAGE=
