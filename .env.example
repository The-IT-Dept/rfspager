# Server
PORT=8080
# Public base URL of this server (used by Stripe redirects, etc.)
BASE_URL=http://localhost:5173

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgres://user:password@localhost:5432/rfspager?sslmode=disable

# Admin JWT Secret (change in production!)
JWT_SECRET=your-secret-key-here

# Bootstrap admin user (seeded on startup if missing)
ADMIN_EMAIL=admin@rfspager.local
ADMIN_PASSWORD=admin1234

# ---------------------------------------------------------------------------
# Push notifications
# ---------------------------------------------------------------------------

# Firebase Cloud Messaging (for Android push notifications)
FIREBASE_CREDENTIALS=/path/to/firebase-credentials.json

# Apple Push Notification Service (for iOS push notifications)
APN_KEY_ID=
APN_TEAM_ID=
APN_BUNDLE_ID=io.devlan.rfspager
APN_PRIVATE_KEY=
APN_PRODUCTION=true

# ---------------------------------------------------------------------------
# In-app purchases — Apple App Store
# ---------------------------------------------------------------------------
# Used for: server-side JWS-signed transaction validation and (optionally) the
# App Store Server API fallback when the app cannot supply a JWS.
# Create the key at App Store Connect → Users and Access → Integrations →
# In-App Purchase. Download the .p8 once; the file content goes in
# APPLE_PRIVATE_KEY (literal newlines or "\n" both work via godotenv).

APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=io.devlan.rfspager

# ---------------------------------------------------------------------------
# In-app purchases — Google Play
# ---------------------------------------------------------------------------
# Path to the service-account JSON used to call Play Developer API. The
# service account needs the "View financial data, orders, and cancellation
# survey responses" + "View and manage" permissions on the Play Console.

GOOGLE_PLAY_CREDENTIALS=/path/to/play-service-account.json
GOOGLE_PLAY_PACKAGE=io.devlan.rfspager

# Real-Time Developer Notifications (RTDN) webhook auth.
# When you configure the Pub/Sub push subscription:
#   - Set "Enable authentication" and pick a service account.
#   - The "Audience" field there becomes GOOGLE_PUBSUB_AUDIENCE — typically
#     the public URL of this webhook (e.g. https://v3.rfspager.app/api/webhooks/google).
#   - GOOGLE_PUBSUB_SERVICE_EMAIL is optional but recommended: the email of
#     the service account used for the push subscription.

GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_EMAIL=

# ---------------------------------------------------------------------------
# Stripe (web checkout fallback)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
