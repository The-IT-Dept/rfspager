# Release lanes for the RFSPager app. The build lanes (ios release, android
# release) are run by .github/workflows/mobile-release.yml on GitHub-hosted
# runners against the native projects `expo prebuild` writes; they end in
# TestFlight and the Play internal track. The store lanes (ios
# submit_for_review, android promote_to_production) take an already-uploaded
# build to the public stores and are run locally by
# scripts/submit-to-stores.sh. Nothing here talks to Expo's build or submit
# services. The whole process is in docs/mobile-releases.md.
#
# Inputs come from the environment (see docs/ci-secrets.md):
#   iOS      ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH,
#            IOS_DIST_CERT_PATH, IOS_DIST_CERT_PASSWORD, IOS_PROFILE_PATH, APPLE_TEAM_ID
#   Android  ANDROID_KEYSTORE_PATH, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS,
#            ANDROID_KEY_PASSWORD, PLAY_JSON_KEY_PATH, PLAY_TRACK
#   Stores   APP_VERSION, BUILD_NUMBER, RELEASE_NOTES_PATH (plus the ASC_* or
#            PLAY_JSON_KEY_PATH keys above)

require "tmpdir"

opt_out_usage
default_platform(:ios)

BUNDLE_ID = "io.devlan.rfspager"

# Store release notes, also used as the Play changelog (500-character limit).
def release_notes
  require_env("RELEASE_NOTES_PATH")
  notes = File.read(ENV["RELEASE_NOTES_PATH"]).strip
  UI.user_error!("Release notes are empty") if notes.empty?
  UI.user_error!("Release notes are #{notes.length} characters; Play allows 500") if notes.length > 500
  notes
end

def asc_api_key
  require_env("ASC_KEY_ID", "ASC_ISSUER_ID", "ASC_KEY_PATH")
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_PATH"]
  )
end

def require_env(*names)
  missing = names.reject { |n| ENV[n].to_s.strip != "" }
  UI.user_error!("Missing environment: #{missing.join(', ')}") unless missing.empty?
end

platform :ios do
  # Compile and archive without signing: proves the app builds when no
  # distribution certificate is configured yet.
  lane :build_unsigned do
    build_app(
      workspace: "ios/RFSPager.xcworkspace",
      scheme: "RFSPager",
      configuration: "Release",
      skip_codesigning: true,
      skip_package_ipa: true,
      archive_path: "build/RFSPager.xcarchive",
      xcargs: "CODE_SIGNING_ALLOWED=NO"
    )
  end

  lane :release do |options|
    require_env("IOS_DIST_CERT_PATH", "IOS_DIST_CERT_PASSWORD", "IOS_PROFILE_PATH", "APPLE_TEAM_ID")
    setup_ci # temporary keychain, so nothing touches the runner's login keychain

    import_certificate(
      certificate_path: ENV["IOS_DIST_CERT_PATH"],
      certificate_password: ENV["IOS_DIST_CERT_PASSWORD"],
      keychain_name: ENV["MATCH_KEYCHAIN_NAME"],
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"]
    )
    install_provisioning_profile(path: ENV["IOS_PROFILE_PATH"])
    profile = FastlaneCore::ProvisioningProfile.parse(ENV["IOS_PROFILE_PATH"])

    update_code_signing_settings(
      path: "ios/RFSPager.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV["APPLE_TEAM_ID"],
      targets: ["RFSPager"],
      bundle_identifier: BUNDLE_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: profile["Name"]
    )

    build_app(
      workspace: "ios/RFSPager.xcworkspace",
      scheme: "RFSPager",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: ENV["APPLE_TEAM_ID"],
      export_options: { provisioningProfiles: { BUNDLE_ID => profile["Name"] } },
      output_directory: "build",
      output_name: "RFSPager.ipa"
    )

    next if options[:skip_upload]

    require_env("ASC_KEY_ID", "ASC_ISSUER_ID", "ASC_KEY_PATH")
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )
    # Lands in TestFlight; promoting to the App Store stays a deliberate step.
    upload_to_testflight(
      api_key: api_key,
      ipa: "build/RFSPager.ipa",
      skip_waiting_for_build_processing: true
    )
  end

  # Takes a build already in TestFlight to App Store review: creates (or
  # reuses) the App Store version, attaches the build, sets the release notes
  # for every locale, and submits with automatic release once Apple approves.
  # The metadata step runs separately first so a submission failure (Apple
  # wants an age-rating or compliance answer) leaves a ready version behind.
  lane :submit_for_review do
    require_env("APP_VERSION", "BUILD_NUMBER")
    api_key = asc_api_key
    notes = release_notes
    common = {
      api_key: api_key, app_identifier: BUNDLE_ID, platform: "ios",
      app_version: ENV["APP_VERSION"], build_number: ENV["BUILD_NUMBER"],
      skip_binary_upload: true, skip_screenshots: true, force: true,
      run_precheck_before_submit: false, precheck_include_in_app_purchases: false
    }
    upload_to_app_store(**common, skip_metadata: false,
                        release_notes: { "default" => notes, "en-AU" => notes },
                        submit_for_review: false)
    upload_to_app_store(**common, skip_metadata: true,
                        submit_for_review: true, automatic_release: true, phased_release: false,
                        submission_information: { export_compliance_uses_encryption: false, add_id_info_uses_idfa: false })
  end
end

platform :android do
  lane :release do |options|
    require_env("ANDROID_KEYSTORE_PATH", "ANDROID_KEYSTORE_PASSWORD", "ANDROID_KEY_ALIAS", "ANDROID_KEY_PASSWORD")
    # The prebuilt project signs release with the debug key; the injected
    # properties replace that with the upload key for this build only.
    #
    # ARM for phones plus x86_64 for Intel Chromebooks, emulators and Google's
    # pre-launch test devices: an ARM-only bundle crashed on launch there with
    # SoLoaderDSONotFoundError (no native libraries for the device). 32-bit x86
    # hardware is effectively extinct, so it is left out to keep the native
    # build shorter. ANDROID_ABIS overrides.
    gradle(
      project_dir: "android",
      task: "bundle",
      build_type: "Release",
      properties: {
        "reactNativeArchitectures" => ENV.fetch("ANDROID_ABIS", "armeabi-v7a,arm64-v8a,x86_64"),
        "android.injected.signing.store.file" => ENV["ANDROID_KEYSTORE_PATH"],
        "android.injected.signing.store.password" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["ANDROID_KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"]
      }
    )
    aab = lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]
    UI.message("Built #{aab}")

    next if options[:skip_upload]

    require_env("PLAY_JSON_KEY_PATH")
    upload_to_play_store(
      package_name: BUNDLE_ID,
      json_key: ENV["PLAY_JSON_KEY_PATH"],
      track: ENV.fetch("PLAY_TRACK", "internal"),
      aab: aab,
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  # Promotes a build from the internal track to production for everyone,
  # with the release notes as its en-AU changelog (the listing's only
  # language).
  lane :promote_to_production do
    require_env("BUILD_NUMBER", "PLAY_JSON_KEY_PATH")
    notes = release_notes
    metadata = Dir.mktmpdir("play-metadata")
    FileUtils.mkdir_p(File.join(metadata, "en-AU", "changelogs"))
    File.write(File.join(metadata, "en-AU", "changelogs", "#{ENV['BUILD_NUMBER']}.txt"), notes)
    upload_to_play_store(
      package_name: BUNDLE_ID,
      json_key: ENV["PLAY_JSON_KEY_PATH"],
      track: "internal", track_promote_to: "production",
      version_code: ENV["BUILD_NUMBER"].to_i, release_status: "completed",
      metadata_path: metadata,
      skip_upload_apk: true, skip_upload_aab: true,
      skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true,
      skip_upload_changelogs: false
    )
  ensure
    FileUtils.rm_rf(metadata) if metadata
  end
end
