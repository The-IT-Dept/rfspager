# Control channels to hunt, MHz, in preference order. Central Coast:
# 420.3 = RFSS 4 site 53, 419.025 = site 51, 419.1125 = site 62 (Bumble Hill).
P25_FREQS=420.3,419.025,419.1125
# Must NOT be the POCSAG receiver's dongle.
P25_DONGLE_SERIAL=
P25_PPM=0
P25_GAIN=400
P25_SERVER_URL=https://rfspager.app
# This receiver's own systems.api_key (not the pager receiver's).
P25_API_KEY=
