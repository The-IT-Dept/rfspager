# syntax=docker/dockerfile:1.7
#
# Multi-stage build for the RFSPager RTL-SDR receiver agent.
#
# The receiver uses cgo to talk to librtlsdr (which itself uses libusb), so
# unlike the server we can't go fully static. We build on golang:1.27.1 +
# Debian 12's librtlsdr-dev for headers/lib, then ship on the matching
# Debian 12 runtime to keep glibc and librtlsdr ABI versions compatible.

# ─── build stage ────────────────────────────────────────────────────────────
FROM golang:1.27.1-bookworm AS build
WORKDIR /src

# librtlsdr-dev pulls in libusb-1.0-0-dev too; pkg-config is used by the
# Go cgo directives at link time.
RUN apt-get update && apt-get install -y --no-install-recommends \
        librtlsdr-dev \
        libusb-1.0-0-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Cache module downloads
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .

ARG VERSION=dev
ARG COMMIT=unknown

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 GOOS=linux \
    go build -tags rtlsdr -trimpath \
        -ldflags="-s -w -X github.com/the-it-dept/rfspager/internal/receiver/buildinfo.InjectedVersion=${VERSION}-${COMMIT}" \
        -o /out/receiver ./cmd/receiver

# ─── binary export stage ────────────────────────────────────────────────────
# `docker buildx build --target binary --output type=local` lifts the compiled
# receiver straight out for release assets, reusing the same toolchain and
# Debian 12 ABI the container ships, so a Pi gets a binary built exactly the way
# the image was.
FROM scratch AS binary
COPY --from=build /out/receiver /receiver

# ─── runtime stage ──────────────────────────────────────────────────────────
FROM debian:bookworm-slim

# librtlsdr0 + libusb provide the runtime shared libs; ca-certificates lets
# the receiver dial wss:// endpoints with a valid trust store.
RUN apt-get update && apt-get install -y --no-install-recommends \
        librtlsdr0 \
        libusb-1.0-0 \
        ca-certificates \
        tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/receiver /usr/local/bin/receiver
COPY LICENSE.md NOTICE THIRD_PARTY_NOTICES.md /usr/share/doc/rfspager/
LABEL org.opencontainers.image.licenses="AGPL-3.0-only"

# RTL-SDR access needs USB device passthrough at run-time:
#   docker run --rm \
#     --device /dev/bus/usb \
#     -e RECEIVER_SERVER_URL=https://rfspager.example.com \
#     -e RECEIVER_API_KEY=... \
#     ghcr.io/the-it-dept/rfspager-receiver:latest

ENTRYPOINT ["/usr/local/bin/receiver"]
