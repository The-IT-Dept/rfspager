# syntax=docker/dockerfile:1.7
#
# Multi-stage build for the RFSPager RTL-SDR receiver agent.
#
# The receiver uses cgo to talk to librtlsdr (which itself uses libusb), so
# unlike the server we can't go fully static. We build on golang:1.25 +
# Ubuntu 24.04's librtlsdr-dev for headers/lib, then ship on a slim
# ubuntu:24.04 runtime with the matching librtlsdr0 + libusb-1.0 packages.

# ─── build stage ────────────────────────────────────────────────────────────
FROM golang:1.25 AS build
WORKDIR /src

# librtlsdr-dev pulls in libusb-1.0-0-dev too; pkg-config is used by the
# Go cgo directives at link time.
RUN apt-get update && apt-get install -y --no-install-recommends \
        librtlsdr-dev \
        libusb-1.0-0-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Cache module downloads
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .

ARG VERSION=dev
ARG COMMIT=unknown

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 GOOS=linux \
    go build -tags rtlsdr -trimpath \
        -ldflags="-s -w -X github.com/the-it-dept/rfspager/internal/receiver/buildinfo.InjectedVersion=${VERSION}-${COMMIT}" \
        -o /out/receiver ./cmd/receiver

# ─── runtime stage ──────────────────────────────────────────────────────────
FROM ubuntu:24.04

# librtlsdr0 + libusb provide the runtime shared libs; ca-certificates lets
# the receiver dial wss:// endpoints with a valid trust store.
RUN apt-get update && apt-get install -y --no-install-recommends \
        librtlsdr0 \
        libusb-1.0-0 \
        ca-certificates \
        tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/receiver /usr/local/bin/receiver

# RTL-SDR access needs USB device passthrough at run-time:
#   docker run --rm \
#     --device /dev/bus/usb \
#     -e RECEIVER_SERVER_URL=https://rfspager.example.com \
#     -e RECEIVER_API_KEY=... \
#     ghcr.io/the-it-dept/rfspager-receiver:latest

ENTRYPOINT ["/usr/local/bin/receiver"]
