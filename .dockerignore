# Keep the Docker build context small for the Go server image.
.git
.github
.claude
.expo
.idea
.vscode
.secrets
.env
.env.*
*.log

# Heavy sibling projects — not needed for the server build.
apps/
# ...except the receiver's local UI, which Dockerfile.receiver builds and embeds.
!apps/receiver-ui/
apps/receiver-ui/node_modules/
laravel-old/
app-old/

# Server-side build leftovers
tmp/
/server
*.exe
*.test
coverage.out

# Docs and license aren't needed in the binary image.
docs/
LICENSE.md
README.md
*.md

# Ship license/attribution with distributed binaries.
!LICENSE.md
!NOTICE
!THIRD_PARTY_NOTICES.md
