# ---------------------------------------------------------------------------
# RFSPager monorepo — root .gitignore
#
# Layout this file covers:
#   ./                  Go server (cmd/, internal/, go.mod)
#   ./apps/mobile       Expo / React Native app
#   ./apps/web          React Router 7 + Vite admin/web UI
#   ./laravel-old       legacy reference (ignored entirely)
# ---------------------------------------------------------------------------

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Env / secrets
.env
.env.local
.env.*.local
.secrets/
*.pem
!internal/iap/apple_root_ca_g3.pem
*.p8
*.p12
*.key
*.keystore
!debug.keystore
*.mobileprovision
*.jks

# Firebase / Google service credentials (per-platform configs are bundled into
# the mobile app at build time, but should be sourced from secret storage).
firebase-credentials*.json
google-services.json
GoogleService-Info.plist
play-service-account*.json

# Legacy reference — keep on disk, never commit.
/laravel-old/

# ---------------------------------------------------------------------------
# Go server (root)
# ---------------------------------------------------------------------------
/tmp/
/server
/cmd/server/server
*.exe
*.test
*.out
coverage.out
vendor/

# ---------------------------------------------------------------------------
# Node / JS (mobile + web)
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
yarn-debug.log*
pnpm-debug.log*
.pnp.*
.cache/

# ---------------------------------------------------------------------------
# Expo / React Native (apps/mobile)
# ---------------------------------------------------------------------------
.expo/
.expo-shared/
web-build/
dist/
expo-env.d.ts
*.jsbundle
.metro-health-check*

# Native build outputs — regenerated by `expo prebuild` / EAS.
apps/mobile/ios/
apps/mobile/android/
apps/mobile/build/
apps/mobile/*.ipa
apps/mobile/*.apk
apps/mobile/*.aab
apps/mobile/*.dSYM.zip

# Xcode
build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData/
*.hmap
*.xcuserstate
project.xcworkspace/

# Android / Gradle
.gradle/
local.properties
*.iml
*.hprof
.cxx/
buck-out/
\.buckd/

# CocoaPods / Ruby
Pods/
vendor/bundle/

# Fastlane
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# ---------------------------------------------------------------------------
# React Router / Vite (apps/web)
# ---------------------------------------------------------------------------
.react-router/
apps/web/build/
apps/web/.vite/

# ---------------------------------------------------------------------------
# Misc large generated artefacts
# ---------------------------------------------------------------------------
*.log
.turbo/

# Receiver build artefacts + agent-side runtime files
/bin/
/receiver
/pager.log
.claude/

# Pre-FSL Expo mobile reference (kept locally, do not check in — 1+ GB)
/app-old/

# local build artifacts
adapty-backfill
migrate-spike
.env.bak-*

# Allow documentation templates while ignoring local credentials.
!**/.env.example

# Strix security-scan output
strix_runs/

# local one-off reporting scripts (store/Adapty credentials, buyer reports);
# the rest of scripts/ is committed
/scripts/rfspager-revenue-report.py
/scripts/out/
/scripts/__pycache__/
